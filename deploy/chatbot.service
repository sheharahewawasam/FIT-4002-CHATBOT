[Unit]
Description=Triple A Super Chatbot (Gunicorn/Django)
After=network.target
# Ollama is optional here: the API serves without it, only /api/chat/ needs it.
Wants=ollama.service

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/chatbot/app/mvp_demo
EnvironmentFile=/opt/chatbot/app/mvp_demo/secrets.env
# One worker only. Each worker holds its own copy of the BGE embedder and
# reranker (~1.6GB); a second would not fit in this instance's 3.8GB.
ExecStart=/opt/chatbot/.venv/bin/gunicorn config.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers 1 \
    --timeout 600 \
    --graceful-timeout 30 \
    --access-logfile /var/log/chatbot-access.log \
    --error-logfile /var/log/chatbot-error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
