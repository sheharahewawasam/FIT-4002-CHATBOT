                181
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "This superannuation Trust Deed is written in plain language. This Trust Deed is in accordance with guidelines issued by the Australian Taxation Office, responsible for regulating Self Managed Superannuation Funds.\n",
            "block_bbox": [
                114,
                251,
                1008,
                342
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "In this document:",
            "block_bbox": [
                112,
                406,
                298,
                432
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": " The singular of any term shall include the plural thereof and the plural of any term shall include the singular.\n",
            "block_bbox": [
                146,
                533,
                1062,
                589
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Each gender shall include each of the other genders..",
            "block_bbox": [
                144,
                598,
                746,
                623
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "\"SISA\"' means the Superannuation Industry (Supervision) Act 1993.",
            "block_bbox": [
                144,
                631,
                915,
                656
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "\"ATO Guidelines' means Running a Self-Managed Super Fund and other updates or relevant guidelines issued by the ATO from time to time.",
            "block_bbox": [
                144,
                665,
                981,
                722
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "paragraph_title",
