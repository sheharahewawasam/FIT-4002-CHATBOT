    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "4.1 Proposed Pipeline Methods ",
            "block_bbox": [
                66,
                68,
                574,
                106
            ],
            "block_id": 0,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Processing of Documents ",
            "block_bbox": [
                67,
                144,
                433,
                177
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Source Ingestion: Documents are ingested directly from the client's existing S3buckets, maintaining the current mapping to MongoDB..",
            "block_bbox": [
                110,
                212,
                1017,
                272
            ],
            "block_id": 2,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "OCR Integration: To process the \"picture-based PDFs\" identified in the source data,the pipeline will utilize the client's existing OCR pipeline for high-fidelity text extraction.\n",
            "block_bbox": [
                110,
                279,
                1067,
                370
            ],
            "block_id": 3,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Robust Metadata Extraction: Since the source data has \"no specific naming scheme,\" the processing stage will include an automated classification step. The system will extract key metadata--such as Fund Name, Effective Date, and Document Type--and store these alongside the vector embeddings to provide structure to the current \"chaos\".\n",
            "block_bbox": [
                110,
                378,
                1034,
                532
            ],
            "block_id": 4,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "Chunking & Embedding: The extracted text is cleaned, split into semantically meaningful chunks, and converted into numerical embeddings for storage in MongoDB Atlas Vector Search.\n",
            "block_bbox": [
                111,
                542,
                991,
                633
            ],
            "block_id": 5,
            "block_order": 6
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Retrieval of Documents.",
            "block_bbox": [
                69,
                669,
                398,
                697
            ],
            "block_id": 6,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Hybrid Search Strategy: Rather than relying solely on semantic similarity, the system utilizes Hybrid Search, which merges vector search with keyword matching. This  ensures the chatbot handles both natural language queries and exact fund-specific terminology with high accuracy..\n",
            "block_bbox": [
                110,
                737,
                1076,
                863
            ],
            "block_id": 7,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Metadata Filtering: The system will use the extracted metadata (e.g., Fund Name) to filter the search space, ensuring that the Al only retrieves relevant rules for the specific fund being queried, further reducing the risk of hallucinations..",
            "block_bbox": [
                110,
                872,
                1075,
                962
            ],
            "block_id": 8,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "How the Al Receives the Documents.",
            "block_bbox": [
                65,
                998,
                579,
                1025
            ],
            "block_id": 9,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Context Augmentation: When a user submits a query, the system retrieves the top-ranked document chunks and appends them to the LLM prompt as grounded context.\n",
            "block_bbox": [
                106,
                1068,
                1039,
                1157
            ],
            "block_id": 10,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "Verifiable Citations: The Al generates responses solely based on these retrieved chunks. Crucially, the response will include direct citations and source links back to  the original PDFs in the S3 bucket, allowing advisors to verify the information.instantly \n",
            "block_bbox": [
                104,
                1167,
                1062,
                1290
            ],
            "block_id": 11,
            "block_order": 12
        }
    ],
