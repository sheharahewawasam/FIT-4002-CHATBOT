    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "Section 34w ",
            "block_bbox": [
                138,
                84,
                297,
                107
            ],
            "block_id": 0,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(c) the person is not regarded as having been convicted of the alleged offence; and \n",
            "block_bbox": [
                300,
                149,
                945,
                202
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(d) the person is not regarded as having admitted guilt or liability for the alleged contravention.\n",
            "block_bbox": [
                301,
                209,
                986,
                264
            ],
            "block_id": 2,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(2) Subsection (1) does not apply if the notice has been withdrawn.",
            "block_bbox": [
                243,
                286,
                948,
                313
            ],
            "block_id": 3,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "34W Effect of this Division ",
            "block_bbox": [
                151,
                349,
                484,
                373
            ],
            "block_id": 4,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "This Division does not:",
            "block_bbox": [
                287,
                399,
                532,
                421
            ],
            "block_id": 5,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(a) require an infringement notice to be given to a person for an alleged contravention of an offence of strict liability in Division 2; or \n",
            "block_bbox": [
                301,
                429,
                980,
                511
            ],
            "block_id": 6,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(b) affect the liability of a person for an alleged contravention of an offence of strict liability in Division 2 if:",
            "block_bbox": [
                300,
                518,
                993,
                572
            ],
            "block_id": 7,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(i) the person does not comply with an infringement notice given to the person for the contravention; or ",
            "block_bbox": [
                358,
                578,
                995,
                635
            ],
            "block_id": 8,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(ii) an infringement notice is not given to the person for the contravention; or \n",
            "block_bbox": [
                353,
                641,
                998,
                696
            ],
            "block_id": 9,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(iii) an infringement notice is given to the person for the contravention and is subsequently withdrawn; or ",
            "block_bbox": [
                347,
                704,
                964,
                759
            ],
            "block_id": 10,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(c) prevent the giving of 2 or more infringement notices to a person for an alleged contravention of an offence of strict liability in Division 2; or \n",
            "block_bbox": [
                303,
                768,
                978,
                851
            ],
            "block_id": 11,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(d) limit a court's discretion to determine the amount of a penalty to be imposed on a person who is found to have contravened an offence of strict liability in Division 2.",
            "block_bbox": [
                304,
                858,
                965,
                940
            ],
            "block_id": 12,
            "block_order": 13
        },
