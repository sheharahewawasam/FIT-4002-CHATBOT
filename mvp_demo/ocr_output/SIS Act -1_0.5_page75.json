    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 1 Preliminary Division 2 Interpretation ",
            "block_bbox": [
                143,
                20,
                406,
                76
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "(b) signed by the trustee or each trustee;",
            "block_bbox": [
                309,
                187,
                759,
                217
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "electing that this Act is to apply in relation to the fund.",
            "block_bbox": [
                296,
                224,
                890,
                248
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Note:The approved form of written notice may require the trustee or the trustees to set out the tax file number of the fund.See subsection 299U(1).\n",
            "block_bbox": [
                298,
                265,
                995,
                331
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Regulations ",
            "block_bbox": [
                300,
                364,
                431,
                386
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(4A) Without limiting subsection (4), regulations for the purposes of that subsection may specify that notices are to be given to different persons or bodies in respect of different classes of superannuation funds.\n",
            "block_bbox": [
                232,
                409,
                1036,
                515
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "Election is irrevocable ",
            "block_bbox": [
                294,
                551,
                550,
                571
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(5) An election made as mentioned in subsection (4) is irrevocable.",
            "block_bbox": [
                246,
                596,
                1000,
                619
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Trustee has power to make election despite anything in the governing rules etc.\n",
            "block_bbox": [
                289,
                652,
                950,
                702
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(6) The trustee or trustees have the power to make an election as mentioned in subsection (4) despite anything in the governing rules of the fund.\n",
            "block_bbox": [
                245,
                729,
                1050,
                806
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "References to repealed provisions of OSSA ",
            "block_bbox": [
                291,
                840,
                775,
                863
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(9) A reference in this section to a provision of the Occupational Superannuation Standards Act 1987 includes a reference to the provision as it continues to apply, despite its repeal, because of the Occupational Superannuation Standards Amendment Act 1993.",
            "block_bbox": [
                246,
                888,
                1038,
                995
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "paragraph_title",
            "block_content": "20 Related bodies corporate ",
            "block_bbox": [
                152,
                1031,
                523,
                1055
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "The question whether bodies corporate are related to each other for the purposes of this Act is to be determined in the same way as that question would be determined under the Corporations Act 2001.",
