    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "About this compilation ",
            "block_bbox": [
                151,
                53,
                530,
                87
            ],
            "block_id": 0,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "This compilation ",
            "block_bbox": [
                150,
                122,
                347,
                146
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "This is a compilation of the Superannuation Industry (Supervision) Act 1993 that shows the text of the law as amended and in force on 18 February 2020 (the compilation date).\n",
            "block_bbox": [
                147,
                160,
                1000,
                247
            ],
            "block_id": 2,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "The notes at the end of this compilation (the endnotes) include information.about amending laws and the amendment history of provisions of the compiled law.\n",
            "block_bbox": [
                147,
                260,
                990,
                344
            ],
            "block_id": 3,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Uncommenced amendments ",
            "block_bbox": [
                148,
                366,
                470,
                387
            ],
            "block_id": 4,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "The effect of uncommenced amendments is not shown in the text of the.compiled law. Any uncommenced amendments affecting the law are accessible.on the Legislation Register (www.legislation.gov.au). The details of amendments made up to, but not commenced at, the compilation date are underlined in the endnotes. For more information on any uncommenced amendments, see the series page on the Legislation Register for the compiled.law.\n",
            "block_bbox": [
                145,
                401,
                995,
                601
            ],
            "block_id": 5,
            "block_order": 6
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Application, saving and transitional provisions for provisions and amendments \n",
            "block_bbox": [
                146,
                619,
                894,
                675
            ],
            "block_id": 6,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "If the operation of a provision or amendment of the compiled law is affected by an application, saving or transitional provision that is not included in this compilation, details are included in the endnotes.\n",
            "block_bbox": [
                147,
                688,
                997,
                776
            ],
            "block_id": 7,
            "block_order": 8
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Editorial changes ",
            "block_bbox": [
                149,
                798,
                352,
                819
            ],
            "block_id": 8,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "For more information about any editorial changes made in this compilation, see the endnotes.\n",
            "block_bbox": [
                148,
                832,
                997,
                889
            ],
            "block_id": 9,
            "block_order": 10
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Modifications ",
            "block_bbox": [
                150,
                911,
                311,
                931
            ],
            "block_id": 10,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "If the compiled law is modified by another law, the compiled law operates as modified but the modification does not amend the text of the law. Accordingly,this compilation does not show the text of the compiled law as modified. For.more information on any modifications, see the series page on the Legislation Register for the compiled law.\n",
            "block_bbox": [
                146,
                945,
                996,
                1090
            ],
            "block_id": 11,
            "block_order": 12
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Self-repealing provisions ",
            "block_bbox": [
                147,
                1111,
                438,
                1135
            ],
            "block_id": 12,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "If a provision of the compiled law has been repealed in accordance with a.provision of the law, details are included in the endnotes.",
            "block_bbox": [
                146,
                1142,
                941,
                1206
            ],
            "block_id": 13,
            "block_order": 14
        }
    ],
