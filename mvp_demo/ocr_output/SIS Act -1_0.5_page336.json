    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Section 91",
            "block_bbox": [
                883,
                81,
                1009,
                104
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "(b) either:",
            "block_bbox": [
                323,
                145,
                435,
                168
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(i) the employer or employers of those members;, or ",
            "block_bbox": [
                379,
                177,
                931,
                202
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(ii) an organisation representing the interests of that employer or those employers.\n",
            "block_bbox": [
                373,
                210,
                928,
                263
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "paragraph_title",
            "block_content": "91 Pre-1 July 1995 rules-funds with 200 or more members ",
            "block_bbox": [
                168,
                297,
                912,
                322
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Application ",
            "block_bbox": [
                300,
                354,
                429,
                376
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(1) This section applies to a standard employer-sponsored fund with 200 or more members, where:",
            "block_bbox": [
                253,
                398,
                1005,
                452
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(a) the fund is a private sector fund established on or after 16 December 1985; or \n",
            "block_bbox": [
                310,
                462,
                964,
                514
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(b) the fund is a public sector fund established on or after 25 May 1988; or \n",
            "block_bbox": [
                307,
                523,
                964,
                579
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(c) if there are 2 or more standard employer-sponsors of the fund--any one of those employer-sponsors is not an associate of any other of those employer-sponsors.",
            "block_bbox": [
                308,
                587,
                999,
                674
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Pre-1 July 1995",
            "block_bbox": [
                293,
                709,
                482,
                734
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(2) This section does not apply on or after 1 July 1995.",
            "block_bbox": [
                246,
                756,
                886,
                785
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Public offer funds ",
            "block_bbox": [
                293,
                818,
                507,
                842
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(3) If the fund is a public offer superannuation fund:.",
            "block_bbox": [
                248,
                865,
                859,
                892
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "(a) either:",
            "block_bbox": [
                314,
                903,
                441,
                926
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "(i) the trustee of the fund must be an independent trustee;or \n",
            "block_bbox": [
                374,
                932,
                1056,
                985
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": "(ii) the fund must comply with the basic equal.representation rules; and ",
            "block_bbox": [
                367,
                995,
                915,
                1050
            ],
            "block_id": 16,
            "block_order": 16
        },
        {
            "block_label": "text",
            "block_content": "(b) if the regulations provide that the fund is subject to rules about the existence, number and functions of policy committees (prescribed policy committees)-the fund must comply with those rules; and ",
            "block_bbox": [
                312,
                1059,
                1046,
                1172
            ],
            "block_id": 17,
            "block_order": 17
        },
        {
            "block_label": "footer",
            "block_content": "Superannuation Industry (Supervision) Act 1993",
            "block_bbox": [
                447,
                1310,
                840,
                1333
            ],
            "block_id": 18,
            "block_order": null
        },
        {
            "block_label": "number",
