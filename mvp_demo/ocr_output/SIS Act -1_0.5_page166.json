        },
        {
            "block_label": "header",
            "block_content": "Section 29XB ",
            "block_bbox": [
                836,
                118,
                999,
                141
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29XB No liability for certain transfers ",
            "block_bbox": [
                152,
                192,
                635,
                216
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "A trustee of a regulated superannuation fund is not subject to any liability to a member of the fund:R01002",
            "block_bbox": [
                290,
                233,
                983,
                292
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(a) for an action taken to give effect to an election made in accordance with section 29SAA or 29SAB; or ",
            "block_bbox": [
                308,
                292,
                945,
                350
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(b) for an action of the kind mentioned in subsection 55C(1)\n",
            "block_bbox": [
                307,
                351,
                973,
                385
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29XC Public sector superannuation scheme ceases to be exempt ",
            "block_bbox": [
                153,
                413,
                964,
                444
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "If APRA becomes aware that:",
            "block_bbox": [
                291,
                468,
                624,
                490
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(a) a public sector superannuation scheme has ceased to be an exempt public sector superannuation scheme; and ",
            "block_bbox": [
                308,
                494,
                1001,
                552
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(b) the scheme is not a regulated superannuation fund that offers a MySuper product;",
            "block_bbox": [
                307,
                555,
                1031,
                615
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "APRA must notify the Fair Work Commission of that fact.",
            "block_bbox": [
                294,
                618,
                944,
                647
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "footer",
