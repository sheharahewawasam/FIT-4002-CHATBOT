    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 2C MySuper ",
            "block_bbox": [
                133,
                10,
                327,
                35
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "under the arrangement are attributed by the trustee or the trustees of the fund to a MySuper product if, despite the fact that the.arrangement does not comply with one or more of the provisions of this section, the arrangement promotes the financial interests of the beneficiaries of the fund who hold the MySuper product..",
            "block_bbox": [
                282,
                171,
                1004,
                307
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29VE Percentage-based administration fees may be capped ",
            "block_bbox": [
                147,
                344,
                887,
                369
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "If, under the governing rules of a regulated superannuation fund:",
            "block_bbox": [
                285,
                392,
                977,
                416
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(a) all or part of the administration fee in relation to a MySuper product is charged to those members of the fund who hold.the product as a percentage of so much of the account balance of each of those members that relates to the MySuper.product; and \n",
            "block_bbox": [
                302,
                425,
                1010,
                562
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(b) the amount of the administration fee is capped at a specified amount; and \n",
            "block_bbox": [
                301,
                570,
                998,
                620
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(c) either:",
            "block_bbox": [
                303,
                634,
                422,
                658
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(i) the cap is the same for all of those members; or ",
            "block_bbox": [
                362,
                666,
                923,
                688
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(ii) if the administration fee is charged at a reduced amount,.in accordance with section 99G, in relation to one or more of those members---the cap is the same for all of.the remainder of those members; and.\n",
            "block_bbox": [
                356,
                697,
                1019,
                807
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(d) but for the fact that the administration fee is capped in that way, a charging rule in section 29vA would be satisfied in.relation to the administration fee;.\n",
            "block_bbox": [
                304,
                817,
                1004,
                899
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "that charging rule is taken to be satisfied in relation to the administration fee.\n",
            "block_bbox": [
                291,
                907,
                929,
                962
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
