    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "MySuper Part 2C Applying for authority Division 2",
            "block_bbox": [
                689,
                29,
                1005,
                83
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 29SB ",
            "block_bbox": [
                852,
                113,
                1005,
                134
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "(i) receiving from the RSE licensee all of the information the RSE licensee was requested to provide under that section; or \n",
            "block_bbox": [
                391,
                178,
                982,
                255
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(ii) all notices relating to that information being disposed of;",
            "block_bbox": [
                382,
                263,
                978,
                313
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "unless APRA extends the period for deciding the application under subsection (2).\n",
            "block_bbox": [
                309,
                321,
                1006,
                372
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(2) APRA may extend the period for deciding an application by an RSE licensee for authority to offer a class of beneficial interest in a regulated superannuation fund as a MySuper product by up to 60days if APRA informs the RSE licensee of the extension:",
            "block_bbox": [
                265,
                393,
                1012,
                499
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(a) in writing; and ",
            "block_bbox": [
                317,
                512,
                525,
                534
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(b) within the period in which it would otherwise be required to decide the application under subsection (1).",
            "block_bbox": [
                312,
                541,
                1006,
                594
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(3) If APRA extends the period for deciding an application for authority to offer a class of beneficial interest in a regulated superannuation fund as a MySuper product, it must decide the application within the extended period.\n",
            "block_bbox": [
                250,
                618,
                972,
                731
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(4) If APRA has not decided an application for authority to offer a class of beneficial interest in a regulated superannuation fund as a MySuper product by the end of the period by which it is required to decide the application, APRA is taken to have decided, at the end of the last day of that period, to refuse the application.",
            "block_bbox": [
                247,
                754,
                1016,
                893
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "footer",
            "block_content": "Superannuation Industry (Supervision) Act 1993",
            "block_bbox": [
                438,
