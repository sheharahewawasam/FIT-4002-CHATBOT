    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Other provisions applying to superannuation entities Part 14",
            "block_bbox": [
                436,
                0,
                1012,
                26
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 117",
            "block_bbox": [
                874,
                90,
                1013,
                115
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "117 Circumstances in which amounts may be paid out of an.employer-sponsored fund to an employer-sponsor ",
            "block_bbox": [
                178,
                156,
                911,
                214
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Excluded superannuation funds ",
            "block_bbox": [
                309,
                243,
                645,
                267
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(2) This section does not apply to an excluded superannuation fund during the period:",
            "block_bbox": [
                264,
                291,
                977,
                342
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(a) beginning on 21 October 1992; and ",
            "block_bbox": [
                325,
                351,
                748,
                375
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(b) ending immediately before the day on which subsection (2A)commenced.\n",
            "block_bbox": [
                322,
                383,
                1017,
                434
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Self managed superannuation funds ",
            "block_bbox": [
                304,
                468,
                690,
                492
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(2A) This section does not apply to a self managed superannuation fund if, at all times after the day on which this subsection commenced when the fund was in existence, the fund was a self managed.superannuation fund.\n",
            "block_bbox": [
                240,
                514,
                1020,
                626
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Basic prohibition ",
            "block_bbox": [
                301,
                662,
                494,
                686
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(3) Except as provided by this section, a trustee of a standard employer-sponsored fund must not pay an amount, or permit an amount to be paid, out of the fund to a standard employer-sponsor..",
            "block_bbox": [
                256,
                708,
                1038,
                791
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(3A) Subsection (3) does not apply in circumstances where:",
            "block_bbox": [
                236,
                815,
                905,
                842
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(a) its application would result in the acquisition of property  from a person otherwise than on just terms; and ",
            "block_bbox": [
                318,
                847,
                997,
                903
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(b) the acquisition would be invalid because of paragraph 51(xxxi) of the Constitution.",
            "block_bbox": [
                319,
                911,
                851,
                966
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Exception-management services ",
            "block_bbox": [
                304,
                997,
                678,
                1022
            ],
            "block_id": 14,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "(4) A reasonable amount may be paid out of any standard employer-sponsored fund to a standard employer-sponsor for services rendered in connection with the management or operation of the fund.\n",
            "block_bbox": [
                260,
                1047,
                1039,
                1158
            ],
            "block_id": 15,
            "block_order": 14
        },
        {
            "block_label": "footer",
            "block_content": "Superannuation Industry (Supervision) Act 1993",
            "block_bbox": [
                453,
                1309,
                836,
                1330
            ],
            "block_id": 16,
