        {
            "block_label": "doc_title",
            "block_content": "An Act to make provision for the supervision of  certain entities engaged in the superannuation  industry, and for related purposes ",
            "block_bbox": [
                160,
                198,
                964,
                319
            ],
            "block_id": 2,
