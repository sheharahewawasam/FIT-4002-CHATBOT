        {
            "block_label": "text",
            "block_content": "A trustee, or group of individual trustees, that has obtained an RSE licence may have a registrable superannuation entity registered under Part 2B. Certain provisions may be contravened if certain activities are carried out while a registrable superannuation entity is not registered (e.g.: accepting contributions while the entity is unregistered may lead to an offence under section 34.)",
            "block_bbox": [
                327,
                149,
                1014,
                313
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Note:A failure to register the fund or trust may also lead to a  breach of an RSE licence condition and possible loss of the RSE licence.\n",
