    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Trust Deed for a Self Managed Superannuation Fund.",
            "block_bbox": [
                297,
                85,
                880,
                119
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "g. Decisions at the meeting must be made unanimously. If a unanimous  decision cannot be reached, the decision must be by majority. If a majority.cannot be reached, or in the event that one or more Member's believes that a proposal is outside the scope of this Deed, and/or would not be in the best interests of all Members:",
            "block_bbox": [
                219,
                173,
                1076,
                322
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "i. That Member/s or Member may notify other Member's of the dispute.\n",
            "block_bbox": [
                306,
                357,
                1017,
                411
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "ii.Within 7 days of notifying other Members, that Member will request the administrator to engage a professional, independent arbitrator, as recommended by the Australian Centre for International Commercial Arbitration.\n",
            "block_bbox": [
                298,
                446,
                1034,
                561
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "iii.  The Member's agree to appoint that arbitrator, to be funded.\nequally by all Members, within 28 days of the Member providing.\nnotice about that dispute.\n\n",
            "block_bbox": [
                289,
                597,
                1058,
                684
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "iv. The decision of the arbitrator will be final, and binding upon all.Members.\n",
            "block_bbox": [
                290,
                717,
                1040,
                770
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "paragraph_title",
            "block_content": "19. Trustee Criteria:",
            "block_bbox": [
                135,
                871,
                378,
                895
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "a. Each Trustee appointed to this Deed must be an individual or corporate entity eligible to act as a Trustee, in accordance with SISA.",
            "block_bbox": [
                214,
                955,
                1048,
                1016
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "b.The appointment of Trustees must be in writing..",
            "block_bbox": [
                213,
                1049,
                799,
                1079
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "c.A Trustee appointment shall cease if that Trustee:",
            "block_bbox": [
                215,
                1111,
                817,
                1142
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "i. is disqualified from holding office as per SISA regulations,",
            "block_bbox": [
                303,
                1169,
                1005,
                1201
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "ii. resigns,",
            "block_bbox": [
                298,
                1236,
                434,
                1261
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "iii. is ill for a prolonged period of time and incapable of adequately performing their role; or \n",
            "block_bbox": [
                292,
                1285,
                1053,
                1352
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "iv. dies.",
            "block_bbox": [
                297,
                1385,
                402,
                1407
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "number",
            "block_content": "9",
            "block_bbox": [
                595,
                1640,
                609,
                1660
            ],
            "block_id": 14,
            "block_order": null
        }
    ],
