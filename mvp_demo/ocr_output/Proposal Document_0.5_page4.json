    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "3.0 What is Rag? Why is it useful here?",
            "block_bbox": [
                101,
                123,
                861,
                167
            ],
            "block_id": 0,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "RAG (Retrieval-Augmented Generation) is a technique used to give Large Language  Models (LLMs) access to specific, private, or up-to-date data without the need to retrain the model itself.\n",
            "block_bbox": [
                100,
                221,
                1065,
                306
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Think of an LLM as a brilliant student taking an exam. Without RAG, the student relies.entirely on their memory (their training data). With RAG, the student is allowed to use an.open textbook to look up specific facts before answering.\n",
            "block_bbox": [
                102,
                332,
                1038,
                417
            ],
            "block_id": 2,
            "block_order": 3
        },
        {
            "block_label": "paragraph_title",
            "block_content": "How It Works.",
            "block_bbox": [
                105,
                445,
                336,
                475
            ],
            "block_id": 3,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "The RAG process follows three main steps:",
            "block_bbox": [
                105,
                503,
                563,
                527
            ],
            "block_id": 4,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "1. Retrieval: When a user asks a question, the system searches a specific database or set of documents for information related to that query.\n",
            "block_bbox": [
                143,
                553,
                1072,
                606
            ],
            "block_id": 5,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "2. Augmentation: The system takes the relevant snippets found during the search and adds them to the user's original prompt as \"context.\"",
            "block_bbox": [
                142,
                615,
                1071,
                670
            ],
            "block_id": 6,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "3. Generation: The LLM reads both the question and the provided context to generate.a precise, grounded answer..\n",
            "block_bbox": [
                142,
                679,
                1067,
                733
            ],
            "block_id": 7,
            "block_order": 8
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Why RAG is Useful.",
            "block_bbox": [
                104,
                782,
                440,
                816
            ],
            "block_id": 8,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "1. Eliminating \"Hallucinations\"",
            "block_bbox": [
                106,
                842,
                518,
                869
            ],
            "block_id": 9,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "LLMs are designed to predict the next word, which sometimes leads them to confidently state facts that are incorrect. By forcing the model to cite specific \"source\" text provided in the prompt, RAG significantly reduces the chances of the Al making things up..",
            "block_bbox": [
                104,
                891,
                1054,
                977
            ],
            "block_id": 10,
            "block_order": 11
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Access to Private or \"Fresh\" Data ",
            "block_bbox": [
                107,
                1002,
                590,
                1025
            ],
            "block_id": 11,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Standard LLMs have a \"knowledge cutoff\" (the date their training ended). They don't know what happened yesterday, and they don't know what is inside your private company files.",
            "block_bbox": [
                106,
                1051,
                1057,
                1107
            ],
            "block_id": 12,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": ". Use Case: An Al can answer questions about a company's 2026 internal travel policy or a project proposal written this morning by \"retrieving\" those specific documents.",
            "block_bbox": [
                148,
                1131,
                1086,
                1186
            ],
            "block_id": 13,
            "block_order": 14
        },
        {
            "block_label": "paragraph_title",
            "block_content": "3. Cost-Effectiveness ",
            "block_bbox": [
                109,
                1232,
                393,
                1256
            ],
            "block_id": 14,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": "Training or \"fine-tuning\" a custom Al model is incredibly expensive, requiring massive computing power and specialized engineers. RAG allows you to achieve high-performance,specialized results using a standard \"off-the-shelf\" model, which is much cheaper and faster to implement.\n",
            "block_bbox": [
                106,
                1281,
                1072,
                1396
            ],
            "block_id": 15,
            "block_order": 16
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4. Transparency and Citations ",
            "block_bbox": [
                107,
                1422,
                507,
                1448
            ],
            "block_id": 16,
            "block_order": 17
        },
        {
            "block_label": "text",
            "block_content": "Because RAG pulls information from specific documents, the system can provide source citations. In an FAQ or legal context, this is vital because it allows the user to verify exactly ",
            "block_bbox": [
                107,
                1469,
                1068,
                1529
            ],
            "block_id": 17,
            "block_order": 18
        }
    ],
