    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Licensing of trustees and groups of individual trustees Part 2A Approval to hold a controlling stake in an RSE licensee Division 8",
            "block_bbox": [
                376,
                1,
                1011,
                60
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 29H ",
            "block_bbox": [
                867,
                96,
                1011,
                120
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Division 8- Approval to hold a controlling stake in an RSE licensee \n",
            "block_bbox": [
                168,
                183,
                1008,
                244
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Subdivision A-Application of this Division ",
            "block_bbox": [
                166,
                278,
                752,
                306
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29H Application ",
            "block_bbox": [
                165,
                339,
                380,
                366
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "This Division only applies in relation to an RSE licensee that is a body corporate.\n",
            "block_bbox": [
                299,
                392,
                995,
                443
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Subdivision B-Applying for approval ",
            "block_bbox": [
                160,
                472,
                688,
                505
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29HA Application for approval to hold a controlling stake ",
            "block_bbox": [
                158,
                538,
                895,
                568
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(1) A person may apply to APRA for approval to hold a controlling stake in an RSE licensee..\n",
            "block_bbox": [
                251,
                590,
                990,
                642
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(2) The application must:",
            "block_bbox": [
                250,
                671,
                539,
                695
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(a) be in the approved form; and ",
            "block_bbox": [
                314,
                704,
                684,
                728
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(b) contain the information required by the approved form.",
            "block_bbox": [
                312,
                737,
                961,
                762
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "-.",
            "block_bbox": [
                250,
                790,
                328,
                816
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(a) a person applies for approval to hold a controlling stake in an RSE licensee, and \n",
            "block_bbox": [
                315,
                819,
                1030,
                872
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(b) after the application is made, but before APRA decides the application, information contained in the application ceases to be correct;",
            "block_bbox": [
                315,
                882,
                1014,
                964
            ],
            "block_id": 14,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "the person must give APRA the correct information, in writing, as soon as practicable after the information in the application ceases to be correct.\n",
            "block_bbox": [
                301,
                973,
                1023,
                1057
            ],
            "block_id": 15,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "(4) An application is taken not to comply with this section if subsection (3) is contravened.\n",
            "block_bbox": [
                259,
                1079,
                926,
                1137
            ],
            "block_id": 16,
            "block_order": 15
        },
        {
