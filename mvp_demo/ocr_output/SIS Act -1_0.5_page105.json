    "parsing_res_list": [
        {
            "block_label": "figure_title",
            "block_content": "Part 2A Licensing of trustees and groups of individual trustees Division 7 Cancelling RSE licences ",
            "block_bbox": [
                137,
                0,
                745,
                51
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 29GB ",
            "block_bbox": [
                143,
                85,
                313,
                108
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "affect the RSE licensee's ability to provide one or more of the financial services (within the meaning of the Corporations Act 2001) that the RSE licensee provides.\n",
            "block_bbox": [
                287,
                152,
                931,
                233
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(2) If APRA cancels the RSE licence of an RSE licensee that is also a financial services licensee, APRA must inform ASIC of the cancellation within one week after the cancellation..",
            "block_bbox": [
                250,
                257,
                972,
                337
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(3) A failure to comply with a requirement of this section does not invalidate the cancellation of an RSE licence..",
            "block_bbox": [
                252,
                362,
                941,
                413
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29GB APRA may allow RSE licence to continue in effect.",
            "block_bbox": [
                161,
                450,
                846,
                474
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "In a notice that APRA gives to an RSE licensee cancelling its RSE licence, APRA may specify that the RSE licence continues in effect as though the cancellation had not happened for the purposes of:",
            "block_bbox": [
                291,
                499,
                998,
                608
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(a) a specified provision, administered by APRA, of this Act, the regulations or the prudential standards; or ",
            "block_bbox": [
                310,
                618,
                1003,
                674
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(b) a specified provision, administered by APRA, of any other law of the Commonwealth;",
            "block_bbox": [
                307,
                681,
                979,
                735
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "in relation to specified matters, a specified period, or both.",
            "block_bbox": [
                292,
                743,
                917,
                772
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
