    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Preliminary Part 1Interpretation Division 2",
            "block_bbox": [
                778,
                33,
                1023,
                86
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 18",
            "block_bbox": [
                899,
                122,
                1024,
                145
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "(b) no declaration under subsection (7) (which allows for funds to be declared not to be public offer superannuation funds) is in force in relation to the fund..\n",
            "block_bbox": [
                325,
                191,
                1019,
                277
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Election to be a public offer superannuation fund ",
            "block_bbox": [
                314,
                303,
                842,
                334
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(2) The trustee of a standard employer-sponsored fund may elect that the fund is to be treated as a public offer superannuation fund.",
            "block_bbox": [
                268,
                349,
                1015,
                407
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "How an election is made.",
            "block_bbox": [
                310,
                437,
                582,
                459
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(3) An election must be made by giving APRA a written notice that is:(a) in the approved form; and ",
            "block_bbox": [
                263,
                479,
                1036,
                540
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(b) signed by the trustee..",
            "block_bbox": [
                324,
                548,
                609,
                573
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "Trustee has power to make election despite anything in the governing rules \n",
            "block_bbox": [
                305,
                600,
                958,
                657
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(4) The trustee has the power to make an election despite anything in the governing rules of the fund.\n",
            "block_bbox": [
                260,
                676,
                1034,
                731
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Election is irrevocable ",
            "block_bbox": [
                308,
                760,
                568,
                784
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(5) An election is irrevocable..",
            "block_bbox": [
                263,
                809,
                608,
                837
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Declaration that fund is a public offer superannuation fund ",
            "block_bbox": [
                308,
                860,
                979,
                887
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(6) APRA may, in writing, declare a superannuation fund to be a public offer superannuation fund.\n",
            "block_bbox": [
                265,
                909,
                997,
                964
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Declaration that fund is not a public offer superannuation fund ",
            "block_bbox": [
                312,
                992,
                1021,
                1018
            ],
            "block_id": 14,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "(7) APRA may, in writing, declare a superannuation fund not to be a public offer superannuation fund.\n",
            "block_bbox": [
                268,
                1040,
                1033,
                1097
            ],
            "block_id": 15,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "(7A) A declaration that a superannuation fund is not a public offer superannuation fund may be subject to conditions.",
            "block_bbox": [
                253,
                1116,
                988,
                1172
            ],
            "block_id": 16,
            "block_order": 15
        },
        {
