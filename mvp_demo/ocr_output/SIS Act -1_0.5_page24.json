    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Preliminary Part 1Preliminary Division 1",
            "block_bbox": [
                810,
                24,
                1043,
                74
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 7",
            "block_bbox": [
                928,
                111,
                1043,
                136
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "(i) the doing of anything after the end of that year of.income, in relation to that year of income,",
            "block_bbox": [
                393,
                175,
                966,
                228
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(ii) the doing of anything after the end of that year of income, in relation any previous year of income; and.",
            "block_bbox": [
                385,
                236,
                1003,
                290
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(c) the following rules apply in relation to the general administration of subparagraphs 42(1AA)(b)(ii) and (c)(ii),subsection 42(1AC), subparagraphs 42A(3)(c)(ii) and (d)(ii)and subsection 42A(4):",
            "block_bbox": [
                331,
                296,
                1027,
                405
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(i) subject to subparagraph (ii), APRA has the general administration of those provisions,",
            "block_bbox": [
                383,
                415,
                983,
                465
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(ii) if another person or body is specified in regulations under subsection 19(4) in respect of a class of superannuation funds, that person or body has the.general administration of those provisions to the extent that they relate to funds belonging to that class..",
            "block_bbox": [
                376,
                473,
                1026,
                610
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "paragraph_title",
            "block_content": "7 Application of Act not to be excluded or modified ",
            "block_bbox": [
                155,
                643,
                819,
                671
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "This Act applies to a superannuation entity despite any provision in the governing rules of the entity, including any provision that purports to substitute, or has the effect of substituting, the provisions of the law of a State or Territory or of a foreign country for all or any of the provisions of this Act.\n",
            "block_bbox": [
                293,
                697,
                1040,
                835
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "paragraph_title",
            "block_content": "8 Act extends to external Territories ",
            "block_bbox": [
                151,
                872,
                628,
                895
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "This Act extends to all the external Territories..",
            "block_bbox": [
                292,
                922,
                810,
                945
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "9 Crown to be bound ",
            "block_bbox": [
                150,
                981,
                434,
                1003
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(1) This Act binds the Crown in all its capacities.",
            "block_bbox": [
                244,
                1031,
                797,
                1056
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(2) The Crown is not liable to be prosecuted for an offence against, or arising out of, this Act.\n",
            "block_bbox": [
                245,
                1081,
                1025,
                1132
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "footer",
            "block_content": "Superannuation Industry (Supervision) Act 1993",
