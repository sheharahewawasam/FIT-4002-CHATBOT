    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Trust Deed for a Self Managed Superannuation Fund ",
            "block_bbox": [
                293,
                76,
                880,
                108
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "10. Membership Criteria:",
            "block_bbox": [
                131,
                158,
                435,
                184
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "a.Each Member must be a Trustee, or a Director of the Corporate Trustee.",
            "block_bbox": [
                212,
                223,
                1046,
                250
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "b.Membership will cease when:.",
            "block_bbox": [
                213,
                283,
                587,
                308
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "i. payment of the Member's benefits are made to the Member or to a benefit arrangement on behalf of the Member; or.",
            "block_bbox": [
                301,
                345,
                1066,
                398
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "ii. the Member dies; or ",
            "block_bbox": [
                295,
                435,
                562,
                458
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "iii. the Member ceases to be a Trustee of the Fund;.",
            "block_bbox": [
                288,
                494,
                858,
                517
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "iv. the remaining Trustees determine on a reasonable basis that the Member should cease to be a member..\n",
            "block_bbox": [
                290,
                554,
                1034,
                607
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "c. New Members can be added to this Trust by that person signing an addendum to this Deed, or an amendment the Deed.",
            "block_bbox": [
                216,
                646,
                993,
                699
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "d. All existing Trustees need to agree in writing to the appointment or removal of any Trustee/s.\n",
            "block_bbox": [
                217,
                735,
                997,
                791
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "11. Membership Compliance:",
            "block_bbox": [
                143,
                890,
                478,
                916
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "a.  A Member must immediately inform the Trustees when:",
            "block_bbox": [
                221,
                977,
                870,
                1002
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "i. The Member enters into an employment arrangement with another Member of the Fund who is not a relative; or.\n",
            "block_bbox": [
                307,
                1036,
                1061,
                1092
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "ii. The Member is disqualified for any reason from being a Trustee of the Fund or Director of the Corporate Trustee of the Fund.",
            "block_bbox": [
                303,
                1125,
                1068,
                1180
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "b. In the event of either 11(a) above, membership must cease as soon as is practical.\n",
            "block_bbox": [
                226,
                1214,
                1039,
                1272
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "paragraph_title",
            "block_content": "12. Member Contributions:",
            "block_bbox": [
                155,
                1362,
                461,
                1384
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": "a. Contributions can be made as lump sum payments, or regular contributions.\n",
            "block_bbox": [
                231,
                1449,
                932,
                1503
            ],
            "block_id": 16,
            "block_order": 16
        },
        {
            "block_label": "number",
            "block_content": "5",
            "block_bbox": [
                588,
