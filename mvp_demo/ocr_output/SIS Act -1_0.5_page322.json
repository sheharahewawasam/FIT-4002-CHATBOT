    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "In-house asset rules applying to regulated superannuation funds Part 8Historical cost ratio of fund's in-house assets Division 2",
            "block_bbox": [
                333,
                12,
                998,
                62
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "Section 76",
            "block_bbox": [
                877,
                98,
                1002,
                121
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Division 2-Historical cost ratio of fund's in-house assets ",
            "block_bbox": [
                165,
                177,
                971,
                205
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "76 Private sector funds established on or after 12 March 1985historical cost ratio for the 1994-95 year of income ",
            "block_bbox": [
                165,
                242,
                952,
                298
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(1) This section applies to a regulated superannuation fund, if the fund is a private sector fund established on or after 12 March 1985.",
            "block_bbox": [
                255,
                322,
                1009,
                373
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(2) At all times during the fund's 1994-95 year of income when the fund was in existence, the historical cost ratio of the fund's in-house assets must not exceed 10%.\n",
            "block_bbox": [
                252,
                396,
                979,
                476
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "77 Private sector funds established before 12 March 1985historical cost ratio for the 1994-95 year of income ",
            "block_bbox": [
                156,
                512,
                926,
                570
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(1) This section applies to a regulated superannuation fund, if the fund is a private sector fund established before 12 March 1985.",
            "block_bbox": [
                246,
                594,
                1023,
                648
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(2) At all times during the fund's 1994-95 year of income when the fund was in existence, the historical cost ratio of the fund's in-house assets must not exceed whichever is the greater of the following percentages:",
            "block_bbox": [
                246,
                673,
                992,
                784
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(a) whichever is the lesser of the following percentages:",
            "block_bbox": [
                310,
                794,
                928,
                819
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(i) the percentage equal to the historical cost ratio of the fund's in-house assets as at the end of 11 March 1985;",
            "block_bbox": [
                368,
                827,
                1005,
                882
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(b) 10%.",
            "block_bbox": [
                312,
                927,
                419,
                952
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(3) Section 72 is to be ignored in working out the percentage mentioned in subparagraph (2)(a)(i).\n",
            "block_bbox": [
                249,
                973,
                912,
                1026
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "paragraph_title",
            "block_content": "78 Public sector funds established on or after 1 July 1990--historical cost ratio for the 1994-95 year of income ",
            "block_bbox": [
                157,
                1062,
                1026,
                1121
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(1) This section applies to a regulated superannuation fund, if the fund is a public sector fund established on or after 1 July 1990.",
            "block_bbox": [
