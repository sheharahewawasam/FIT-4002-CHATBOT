    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "where the information came from (e.g., \"According to Section 4.2 of the Employee Handbook...\").\n",
            "block_bbox": [
                93,
                88,
                980,
                152
            ],
            "block_id": 0,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "5. Easy Data Management ",
            "block_bbox": [
                99,
                183,
                456,
                214
            ],
            "block_id": 1,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "If a policy changes, you don't need to retrain the Al. You simply update the text file in your  database. The next time the RAG system performs a search, it will find the new document and provide the updated information immediately.\n",
            "block_bbox": [
                99,
                235,
                1065,
                331
            ],
            "block_id": 2,
            "block_order": 3
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Developer Frameworks (For building custom solutions)",
            "block_bbox": [
                102,
                387,
                856,
                415
            ],
            "block_id": 3,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "If you have engineering resources and want full control over the pipeline, these are the industry standards:",
            "block_bbox": [
                102,
                432,
                1030,
                489
            ],
            "block_id": 4,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "Llamalndex: Widely considered the best orchestration framework for RAG. It excels at \"data ingestion\"-it has over 160 connectors to pull FAQs from PDFs, Notion,Slack, or SQL databases. It is highly optimized for document Q&A.",
            "block_bbox": [
                143,
                521,
                1085,
                610
            ],
            "block_id": 5,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "LangChain: The most popular framework for building LLM applications. It is very  modular, allowing you to swap out different vector databases (like Pinecone or Weaviate) and LLMs (like GPT-4 or Claude) easily.\n",
            "block_bbox": [
                145,
                619,
                1054,
                711
            ],
            "block_id": 6,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Haystack: An open-source framework by Deepset specifically designed for building production-ready search and Q&A systems. It is often cited as being more streamlined for \"search-centric\" RAG than LangChain.\n",
            "block_bbox": [
                148,
                719,
                1082,
                811
            ],
            "block_id": 7,
            "block_order": 8
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Managed & \"No-Code\" Platforms (For fast deployment)",
            "block_bbox": [
                110,
                847,
                854,
                877
            ],
            "block_id": 8,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "If you want to upload a document and have a functioning FAQ bot in minutes without managing infrastructure:",
            "block_bbox": [
                109,
                890,
                1011,
                951
            ],
            "block_id": 9,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Wonderchat / Chatbase: These are \"RAG-as-a-Service\" platforms. You provide a URL or upload a PDF of your FAQs, and they provide an embeddable chat widget.They handle the embedding, storage, and retrieval layers internally.",
            "block_bbox": [
                148,
                981,
                1068,
                1074
            ],
            "block_id": 10,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "Docsie: Specifically designed for documentation and internal knowledge bases. It  features \"version awareness,\" which is useful if your FAQs change based on different product versions.\n",
            "block_bbox": [
                147,
                1079,
                1098,
                1173
            ],
            "block_id": 11,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Danswer: An open-source enterprise search engine that you can self-host. It connects to your company's tools (Google Drive, Confluence, etc.) and provides a ChatGPT-like interface for asking questions across all those sources.",
            "block_bbox": [
                147,
                1178,
                1062,
                1267
            ],
            "block_id": 12,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "Similar existing software, with RAG functions:",
            "block_bbox": [
                106,
                1332,
                588,
                1355
            ],
            "block_id": 13,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "Make.com ",
            "block_bbox": [
                145,
                1366,
                299,
                1388
            ],
            "block_id": 14,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": " n8n.io ",
            "block_bbox": [
                145,
                1398,
                254,
                1420
            ],
            "block_id": 15,
            "block_order": 16
        },
        {
            "block_label": "text",
            "block_content": "These are automation softwares with additional features centered around Al automation ",
            "block_bbox": [
                105,
                1430,
                1051,
                1454
            ],
            "block_id": 16,
            "block_order": 17
        }
    ],
