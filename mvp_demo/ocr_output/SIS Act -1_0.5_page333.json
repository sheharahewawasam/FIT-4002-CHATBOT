    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 9 Equal representation of employers and members-employer-sponsored funds ",
            "block_bbox": [
                156,
                0,
                976,
                27
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Section 86",
            "block_bbox": [
                157,
                87,
                286,
                109
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Part 9-Equal representation of employers and members- employer-sponsored funds ",
            "block_bbox": [
                159,
                180,
                938,
                253
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "86 Object of Part ",
            "block_bbox": [
                158,
                308,
                384,
                333
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "The object of this Part is to set out rules about the representation of employers and members in relation to the management and control of standard employer-sponsored funds.\n",
            "block_bbox": [
                293,
                355,
                1023,
                437
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "87 Consequences of non-compliance with this Part.",
            "block_bbox": [
                154,
                476,
                801,
                502
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "It is not an offence to contravene this Part and a failure to comply with this Part does not result in the invalidity of a transaction..However, a contravention of this Part may result in a fund being.directed under section 63 not to accept any contributions made to the fund by an employer-sponsor (see subsection 63(6)).",
            "block_bbox": [
                290,
                526,
                1021,
                669
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "paragraph_title",
            "block_content": "88 This Part does not apply if acting trustee appointed under Part 17\n",
            "block_bbox": [
                151,
                708,
                946,
                764
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "This Part does not apply to a fund if the fund has an acting trustee appointed under Part 17.\n",
            "block_bbox": [
                288,
                790,
                1032,
                845
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "paragraph_title",
            "block_content": "89 Basic equal representation rules ",
            "block_bbox": [
                149,
                882,
                612,
                908
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "Basic rule ",
            "block_bbox": [
                291,
                940,
                412,
                961
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(1) For the purposes of this Part, a fund complies with the basic equal.representation rules if:",
            "block_bbox": [
                243,
                986,
                1033,
                1041
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(a) both:",
            "block_bbox": [
                312,
                1051,
                419,
                1076
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(i) the fund has a group of individual trustees;.",
            "block_bbox": [
                372,
                1082,
                897,
                1106
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "(ii) the group of trustees consists of equal numbers of employer representatives and member representatives;or \n",
            "block_bbox": [
                366,
                1115,
                1021,
                1196
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "(b) both:",
            "block_bbox": [
                314,
                1208,
                420,
                1233
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "number",
