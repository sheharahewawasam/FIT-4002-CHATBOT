    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 6 Provisions relating tc \n\n",
            "block_bbox": [
                160,
                0,
                866,
                19
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Section 51",
            "block_bbox": [
                161,
                82,
                292,
                105
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Part 6 Provisions relating to governing rules of superannuation entities ",
            "block_bbox": [
                163,
                176,
                985,
                250
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "51 Object of Part ",
            "block_bbox": [
                161,
                303,
                393,
                328
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "The object of this Part is to set out rules about the content of the governing rules of superannuation entities.\n",
            "block_bbox": [
                300,
                354,
                1006,
                407
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "51A Covenants are cumulative ",
            "block_bbox": [
                158,
                441,
                558,
                466
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "To avoid doubt, each covenant referred to in sections 52 to 53 or prescribed under section 54A that applies to a trustee of a superannuation entity, or a director of a corporate trustee of a superannuation entity, applies in addition to every other covenant or obligation referred to in those sections that applies to the trustee or director.\n",
            "block_bbox": [
                296,
                496,
                1032,
                663
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "paragraph_title",
            "block_content": "52 Covenants to be included in governing rules-registrable superannuation entities ",
            "block_bbox": [
                152,
                703,
                935,
                765
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Governing rules taken to contain covenants ",
            "block_bbox": [
                295,
                798,
                782,
                821
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(1) If the governing rules of a registrable superannuation entity do not contain covenants to the effect of the covenants set out in this section, those governing rules are taken to contain covenants to that effect.\n",
            "block_bbox": [
                246,
                846,
                1034,
                955
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "General covenants ",
            "block_bbox": [
                295,
                990,
                510,
                1011
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(2) The covenants referred to in subsection (1) include the following covenants by each trustee of the entity:",
            "block_bbox": [
                247,
                1040,
                1020,
                1093
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(a) to act honestly in all matters concerning the entity;",
            "block_bbox": [
                313,
                1104,
                927,
                1127
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "(b) to exercise, in relation to all matters affecting the entity, the same degree of care, skill and diligence as a prudent superannuation trustee would exercise in relation to an entity ",
            "block_bbox": [
                312,
                1137,
                1026,
                1217
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "number",
            "block_content": "216",
            "block_bbox": [
                155,
                1304,
                188,
                1321
            ],
            "block_id": 14,
            "block_order": null
        },
        {
            "block_label": "footer",
            "block_content": "Superannuation Industry (Supervision) Act 1993",
            "block_bbox": [
                435,
                1307,
                825,
                1326
            ],
            "block_id": 15,
            "block_order": null
        },
        {
