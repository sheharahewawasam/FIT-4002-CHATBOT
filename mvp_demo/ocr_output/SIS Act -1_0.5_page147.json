    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 2C MySuper Division 4 Cancelling authority ",
            "block_bbox": [
                137,
                15,
                460,
                74
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 29UB ",
            "block_bbox": [
                141,
                105,
                313,
                128
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(2) If APRA cancels the authority of an RSE licensee that is also a financial services licensee, APRA must inform ASIC of the cancellation within one week after the cancellation.",
            "block_bbox": [
                243,
                176,
                950,
                257
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(3) A failure to comply with a requirement of this section does not.\ninvalidate the cancellation of an authority to offer a class of.\nbeneficial interest in a regulated superannuation fund as a MySuper \n product.\n\n",
            "block_bbox": [
                248,
                282,
                1004,
                391
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29UB APRA may allow authority to continue in effect ",
            "block_bbox": [
                159,
                426,
                828,
                451
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "In a notice that APRA gives to an RSE licensee cancelling an authority, APRA may specify that the authority continues in effect.as though the cancellation had not happened for the purposes of:.",
            "block_bbox": [
                291,
                474,
                1010,
                556
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(a) a specified provision, administered by APRA, of this Act, the.regulations or the prudential standards; or ",
            "block_bbox": [
                310,
                562,
                1016,
                616
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(b) a specified provision, administered by APRA, of any other.law of the Commonwealth;",
            "block_bbox": [
                307,
                622,
                991,
                676
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "in relation to specified matters, a specified period, or both..",
            "block_bbox": [
                292,
                684,
                927,
                711
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
