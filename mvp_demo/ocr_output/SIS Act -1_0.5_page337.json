    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 9 Equal representation of employers and members- employer-sponsored funds ",
            "block_bbox": [
                157,
                1,
                947,
                28
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 92",
            "block_bbox": [
                162,
                90,
                290,
                112
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(c) each prescribed policy committee must consist of equal.numbers of employer representatives and member representatives.\n",
            "block_bbox": [
                318,
                150,
                918,
                230
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Non-public offer funds.",
            "block_bbox": [
                302,
                262,
                530,
                286
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(4) If the fund is not a public offer superannuation fund, the fund must comply with the basic equal representation rules..",
            "block_bbox": [
                258,
                308,
                987,
                362
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Transitional ",
            "block_bbox": [
                300,
                391,
                431,
                413
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "(5) If, at a particular time, the number of members of a fund increases from a number less than 200 to 200 or more:",
            "block_bbox": [
                252,
                438,
                989,
                490
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(a) the trustee of the fund must make such arrangements (if any).\nas are necessary to enable the fund to comply with this.\nsection; and \n\n",
            "block_bbox": [
                310,
                500,
                998,
                579
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(b) the fund does not have to comply with this section during the.period:",
            "block_bbox": [
                307,
                589,
                1006,
                644
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(i) beginning at that time; and ",
            "block_bbox": [
                368,
                653,
                701,
                678
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "(ii) ending at whichever is the earlier of the following times:",
            "block_bbox": [
                361,
                685,
                949,
                738
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "(A) the time at which such arrangements are made;",
            "block_bbox": [
                447,
                747,
                1010,
                773
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "(B) the end of 90 days.",
            "block_bbox": [
                450,
                783,
                709,
                807
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "paragraph_title",
            "block_content": "92 Post-30 June 1995 rules--funds with more than 4, but fewer than.50, members \n",
            "block_bbox": [
                149,
                843,
                1019,
                903
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "Application ",
            "block_bbox": [
                292,
                938,
                427,
                961
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "(1) This section applies to a standard employer-sponsored fund with.more than 4, but fewer than 50, members.\n",
            "block_bbox": [
                246,
                978,
                1001,
                1036
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": "Post-30 June 1995",
            "block_bbox": [
                296,
                1068,
                507,
                1094
            ],
            "block_id": 16,
            "block_order": 16
        },
        {
            "block_label": "text",
            "block_content": "(2) This section applies on and after 1 July 1995.",
