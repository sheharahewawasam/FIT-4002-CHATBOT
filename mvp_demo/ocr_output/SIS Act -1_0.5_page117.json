    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "Part 2B Registrable superannuation entities Division 3 Registration ",
            "block_bbox": [
                132,
                0,
                575,
                52
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 29MC ",
            "block_bbox": [
                138,
                86,
                319,
                108
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(b) any other document in which the RSE licensee identifies itself as the RSE licensee of the entity; and.",
            "block_bbox": [
                305,
                156,
                942,
                208
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "(c) if the RsE licensee is a body corporate-any document in which the body corporate identifies itself as a trustee of the entity; and \n",
            "block_bbox": [
                310,
                218,
                974,
                298
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "(d) if the RSE licensee is a group of individual trustees-any document that a member of the group gives to APRA or in which a member of the group identifies itself as a trustee of the entity or as a member of a group of individual trustees that are the RSE licensee of the entity..\n",
            "block_bbox": [
                311,
                308,
                982,
                441
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "(2) However, an RSE licensee is not required to comply with subsection (1) in respect of a particular document if the RSE licensee has been given written approval by APRA not to ensure that the ABN is included in that document or in a class of documents that includes that document..\n",
            "block_bbox": [
                251,
                466,
                979,
                603
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "paragraph_title",
            "block_content": "29MC APRA to give notice of refusal of applications ",
            "block_bbox": [
                159,
                643,
                817,
                668
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "If APRA refuses an application by an RSE licensee for registration of a registrable superannuation entity, APRA must take all reasonable steps to ensure that the RSE licensee is given a notice:",
            "block_bbox": [
                291,
                692,
                1013,
                777
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "(a) informing it of APRA's refusal of the application; and ",
            "block_bbox": [
                312,
                785,
                949,
                812
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "(b) setting out the reasons for the refusal;.",
            "block_bbox": [
                312,
                820,
                770,
                843
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "as soon as practicable after refusing the application.",
            "block_bbox": [
                296,
                851,
                860,
                878
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "number",
            "block_content": "102",
            "block_bbox": [
                175,
