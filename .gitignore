# Secrets
secrets.env
mvp_demo/secrets.env
.env
mvp_demo/.env
*.pem

# Terraform — never commit state, vars or provider binaries
oci-infra/terraform.tfvars
oci-infra/.terraform/
oci-infra/*.tfstate
oci-infra/*.tfstate.backup
oci-infra/.terraform.lock.hcl

# Python
*.pyc
__pycache__/
.venv/

# Local data / artefacts
*.sqlite3
mvp_demo/media/
mvp_demo/chroma_db/
TestData/

# Audit logs are a transcript of real questions and answers about real funds.
# They belong on the server that produced them, not in version control.
audit_logs/

# Chunking debug output: ~16 MB of snapshots regenerated by any ingest run.
mvp_demo/test_chunking_output/

# Fund documents. The sample PDFs already tracked at pdfs/ stay, but client
# documents must not be committed - they are confidential and ~40 MB a set.
# Keep them outside the repo and point ingest.py at them locally.

# OS
.DS_Store
